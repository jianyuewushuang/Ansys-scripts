#   data/      模型
#   results/   交付物：图片 / 报表 / 系数
#   artifacts/ 生成的几何 · 网格 · case
#   work/      Fluent 启动临时目录
#   logs/      运行日志

# ---------- 1. Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- 2. 生成物根目录 ----------
# artifacts/geometry  aircraft_solid.stl、fluid_domain.stl（3 + 16 MB）
# artifacts/mesh      *.msh.h5（79 + 37 MB）
# artifacts/cases     *.cas.h5 / *.dat.h5（8 个，约 409 MB）
# 全部可由 scripts/01_geometry 与 scripts/02_mesh、03_solve 重算
artifacts/

# 兜底：万一生成物被写到别处
*.msh.h5
*.msh
*.cas.h5
*.cas
*.dat.h5
*.dat

# ---------- 3. Fluent / Ansys 运行残留 ----------
# PyFluent 启动工作目录（FM_* 临时、*_workflow_files 缓存）
work/
*_workflow_files/
# Fluent 自动生成的清理批处理
cleanup-fluent-*.bat
# transcript / journal
*.trn
*.jou

# ---------- 4. 日志 ----------
logs/
*.log

# ---------- 5. 模型与结果----------
data/
results/
docs/技术报告.md

# ---------- 6. 工作环境 ----------
.workbuddy/
